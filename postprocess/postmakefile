main = post_process.f90

#lib and other stuff to include to the compiler 
incs = -I${HEADAS}/include -I${HEADAS}/include/fftw -ffree-line-length-none
libs = -L${HEADAS}/lib -lfftw3 -lm -lXSFunctions -lcfitsio -lXSModel -lXSUtil -lXS -lCCfits_2.6
fitsio = 
optimization = -O3
debug        = -Wall -pedantic


# set compilers
fcomp = gfortran $(optimization) #$(debug) 
ccomp = gcc      $(optimization) 

# the files to compile 
FCODE = $(main)
CCODE = ../relmodels.c ../rellp.c ../relbase.c ../reltable.c ../relutility.c ../donthcomp.c ../xilltable.c ../relcache.c

mod:
	$(fcomp) $(incs) $(libs) -c ../amodules.f90
fobj: $(FCODE)
	$(fcomp) -c $(FCODE)

cobj: 
	$(ccomp) -c $(CCODE)

compile: mod fobj cobj
	 $(fcomp) -fno-second-underscore -fno-automatic -fPIC $(incs) *.o -o post_process $(libs)

	 
main: clean compile cleanup

clean:
	rm -vf *.o *.mod *~ subroutines/*~
cleanup:
	rm -vf *.o *.mod *~ subroutines/*~
